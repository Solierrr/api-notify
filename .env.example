# Fonte de verdade real é o Infisical — este arquivo só documenta quais
# variáveis existem. Ver design em docs-warehouse/architecture.

# /database
DB_MONGO_URI=mongodb://localhost:27017
DB_MONGO_NOTIFY=solaria_notify_db

# /auth
SERVICE_KEY_API_MESSENGER=
SERVICE_KEY_API_CORE=

# /service-urls
JWT_JWK_SET_URI=http://localhost:8081/.well-known/jwks.json

# /fcm
# FCM_ENABLED deve ser exatamente true ou false; true liga o envio real via Firebase; false mantém o PushSender que só registra em log
FCM_ENABLED=false
# Conta de serviço do projeto solaria-authenticator em base64 (base64 -w0 <arquivo>.json)
FCM_CREDENTIALS_BASE64=
# Opcional: projeto solaria-authenticator, compartilhado com o api-auth; em branco usa o project_id da conta de serviço
FIREBASE_PROJECT_ID=
# true valida credencial e payload no FCM sem entregar o push
FCM_DRY_RUN=false
# Timeouts HTTP com o FCM, em milissegundos
FCM_CONNECT_TIMEOUT_MS=5000
FCM_READ_TIMEOUT_MS=10000

# /otel
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SERVICE_VERSION=dev
DEPLOYMENT_ENVIRONMENT=local
OTEL_TRACES_SAMPLING_PROBABILITY=1.0
